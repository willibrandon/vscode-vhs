{
  "comments": {
    "lineComment": { "comment": "#", "noIndent": false }
  },
  "brackets": [
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] },
    { "open": "/", "close": "/", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["/", "/"],
    ["[", "]"],
    ["{", "}"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*(?:region\\b|.+\\{\\{\\{)",
      "end": "^\\s*#\\s*(?:endregion\\b|\\}\\}\\})"
    }
  }
}
